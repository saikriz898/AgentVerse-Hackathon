PROJECT_NAME="LifeOS Review Agent"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-mode-lifeos-review-agent"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (Defaults to SQLite async if postgres URL not supplied, or asyncpg PostgreSQL URL)
DATABASE_URL="sqlite+aiosqlite:///./review_agent.db"
# Example PostgreSQL URL: postgresql+asyncpg://postgres:postgres@localhost:5432/review_agent_db

# Gemini AI Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Server Configuration
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="development"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
