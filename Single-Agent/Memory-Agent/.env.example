# Environment Mode
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database Configuration
# Options: 'sqlite' or 'postgres'
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite.db

# Production Postgres (Neon / standard Postgres)
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://user:pass@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=super-secret-antigravity-key-32-chars-long-x891
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Redis & Queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
