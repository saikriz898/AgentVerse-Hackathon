# LifeOS Communication Agent v2.0 Enterprise Environment Variables
PROJECT_NAME="LifeOS Communication Agent"
PORT=8002
ENVIRONMENT=production

# Gemini AI Engine Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./communication_agent.db
# PostgreSQL Production Example:
# DATABASE_URL=postgresql+asyncpg://lifeos_user:lifeos_password@localhost:5432/communication_db

# Caching & Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication Secrets
SECRET_KEY=super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Chief of Staff Broadcast Sync
CHIEF_OF_STAFF_URL=http://localhost:8000/api/v1/chief-of-staff/webhook
