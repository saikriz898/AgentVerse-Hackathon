# LifeOS Research Agent Configuration

# Environment & Server
ENV=development
DEBUG=True
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lifeos_research

# Authentication Secret
SECRET_KEY=lifeos_research_agent_super_secret_key_2026
